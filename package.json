{
  "name": "clinic-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx scripts/build-images.ts && next dev",
    "prebuild": "tsx scripts/build-images.ts && tsx scripts/check-content.ts",
    "build": "next build",
    "content:report": "tsx scripts/check-content.ts --report",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/build-e2e.mjs && playwright test",
    "serve": "node scripts/serve-static.mjs out 4000",
    "format": "prettier --write ."
  },
  "dependencies": {
    "next": "16.3.8",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@fontsource/be-vietnam-pro": "^5.2.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "prettier": "^3.6.0",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "wrangler": "^4.147.0"
  }
}
